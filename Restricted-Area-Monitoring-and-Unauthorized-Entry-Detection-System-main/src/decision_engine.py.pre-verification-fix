"""
Decision Engine Module
=======================
Combines results from all detection modules (face, plate, animal)
and generates final verdicts for each detection in the restricted area.

This module determines whether each detected entity represents an
authorized or unauthorized entry and assigns severity levels.
"""

import csv
import os
import re
from collections import Counter, deque
from datetime import datetime
from typing import List, Dict, Optional
from dataclasses import dataclass, field

from src import (
    Detection, PersonResult, VehicleResult, AnimalResult, FrameResult
)


# ============================================================
# Alert Data Structure
# ============================================================

@dataclass
class Alert:
    """
    Represents a single alert generated by the decision engine.
    
    Attributes:
        timestamp: When the alert was generated
        frame_index: Frame number where detection occurred
        alert_type: Category of alert (person/vehicle/animal)
        severity: Alert severity level (LOW/MEDIUM/HIGH/CRITICAL)
        message: Human-readable description of the alert
        details: Dictionary with additional detection details
    """
    timestamp: str
    frame_index: int
    alert_type: str          # "person", "vehicle", "animal"
    severity: str            # "LOW", "MEDIUM", "HIGH", "CRITICAL"
    message: str
    details: Dict = field(default_factory=dict)


# ============================================================
# Decision Engine Class
# ============================================================

class DecisionEngine:
    """
    Evaluates detection results and generates alerts based on
    predefined rules for each object type.
    
    Decision Rules:
        - Person detected with face → HIGH alert (unauthorized person identified)
        - Person detected without face → MEDIUM alert (person detected, face unclear)
        - Vehicle with plate read → MEDIUM alert (plate captured)
        - Vehicle without plate → HIGH alert (unidentified vehicle)
        - Domestic animal → LOW alert (minor intrusion)
        - Wild/dangerous animal → HIGH/CRITICAL alert (safety hazard)
    """
    
    def __init__(self, config: dict):
        """
        Initialize the Decision Engine with configuration settings.
        
        Args:
            config: Dictionary loaded from settings.yaml
        """
        self.config = config
        self.alerts: List[Alert] = []
        self.all_frame_results: List[FrameResult] = []
        
        # Load severity settings from config
        alert_config = config.get("alerts", {})
        self.severity_map = alert_config.get("severity_levels", {
            "person": "HIGH",
            "vehicle": "MEDIUM",
            "animal_domestic": "LOW",
            "animal_wild": "HIGH"
        })
        
        # Person/animal cooldowns are category-based as before. Vehicle alerts
        # use per-vehicle tracks so one car cannot suppress another car's alert.
        self.cooldown_seconds = alert_config.get("cooldown_seconds", 5)
        self._last_alert_frame: Dict[str, int] = {}

        self.vehicle_track_timeout_seconds = max(
            0.5, float(alert_config.get("vehicle_track_timeout_seconds", 2.0))
        )
        self.vehicle_track_iou_threshold = min(
            1.0, max(0.0, float(alert_config.get("vehicle_track_iou_threshold", 0.10)))
        )
        self.vehicle_entry_confirm_frames = max(
            1, int(alert_config.get("vehicle_entry_confirm_frames", 2))
        )
        
        self.vehicle_exit_confirm_frames = max(
            1, int(alert_config.get("vehicle_exit_confirm_frames", 2))
        )

        self.plate_verification_min_readings = max(
            1, int(alert_config.get("plate_verification_min_readings", 1))
        )
        self.plate_verification_window = max(
            self.plate_verification_min_readings,
            int(alert_config.get("plate_verification_window", 5))
        )

        self._vehicle_tracks: Dict[int, Dict] = {}
        self._next_vehicle_track_id = 1
        self._matched_vehicle_track_ids = set()


        # Authorization settings
        auth_config = config.get("authorization", {})
        plates_file = auth_config.get("authorized_plates_file", "config/authorized_plates.json")
        if plates_file and not os.path.isabs(plates_file):
            project_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
            self.authorized_plates_file = os.path.abspath(os.path.join(project_root, plates_file))
        else:
            self.authorized_plates_file = plates_file

    def _load_authorized_plates(self) -> List[str]:
        """Load and normalize authorized plates from the local JSON file."""
        import json
        if os.path.exists(self.authorized_plates_file):
            try:
                with open(self.authorized_plates_file, 'r', encoding='utf-8') as f:
                    plates = json.load(f)
                    if isinstance(plates, list):
                        return [str(p).strip().upper() for p in plates]
            except Exception as e:
                print(f"[DecisionEngine] Error loading authorized plates: {e}")
        else:
            print(f"[DecisionEngine] Warning: authorized plates file not found at {self.authorized_plates_file}")
        return []
    
    # --------------------------------------------------------
    # Main Processing Method
    # --------------------------------------------------------
    
    def process_frame_result(self, frame_result: FrameResult,
                              fps: float = 30.0) -> List[Alert]:
        """Process one frame and emit alerts for confirmed restricted-zone events.

        Vehicle observations are processed even when motion detection is false,
        because vehicles outside the polygon are required to establish entry/exit.
        Person and animal alert behavior remains gated by ROI motion as before.
        """
        frame_alerts = []
        self.all_frame_results.append(frame_result)
        safe_fps = fps if fps and fps > 0 else 30.0
        self._expire_vehicle_tracks(frame_result.frame_index, safe_fps)
        self._matched_vehicle_track_ids = set()

        if frame_result.motion_detected:
            for person in frame_result.persons:
                alert = self._evaluate_person(person, frame_result.frame_index, safe_fps)
                if alert:
                    frame_alerts.append(alert)

        # New code uses vehicle_observations (inside + outside the zone). Fall
        # back to vehicles for backward compatibility with older FrameResult users.
        observations = getattr(frame_result, "vehicle_observations", None)
        if not observations:
            observations = frame_result.vehicles
        for vehicle in observations:
            alert = self._evaluate_vehicle(vehicle, frame_result.frame_index, safe_fps)
            if alert:
                frame_alerts.append(alert)

        if frame_result.motion_detected:
            for animal in frame_result.animals:
                alert = self._evaluate_animal(animal, frame_result.frame_index, safe_fps)
                if alert:
                    frame_alerts.append(alert)

        self.alerts.extend(frame_alerts)
        return frame_alerts

    @staticmethod
    def _bbox_iou(box_a, box_b) -> float:
        """Calculate intersection-over-union for two (x1, y1, x2, y2) boxes."""
        ax1, ay1, ax2, ay2 = [float(v) for v in box_a]
        bx1, by1, bx2, by2 = [float(v) for v in box_b]
        ix1, iy1 = max(ax1, bx1), max(ay1, by1)
        ix2, iy2 = min(ax2, bx2), min(ay2, by2)
        inter_w, inter_h = max(0.0, ix2 - ix1), max(0.0, iy2 - iy1)
        intersection = inter_w * inter_h
        area_a = max(0.0, ax2 - ax1) * max(0.0, ay2 - ay1)
        area_b = max(0.0, bx2 - bx1) * max(0.0, by2 - by1)
        union = area_a + area_b - intersection
        return intersection / union if union > 0 else 0.0

    @staticmethod
    def _bbox_center_and_diagonal(box):
        x1, y1, x2, y2 = [float(v) for v in box]
        width, height = max(1.0, x2 - x1), max(1.0, y2 - y1)
        return ((x1 + x2) / 2.0, (y1 + y2) / 2.0, (width ** 2 + height ** 2) ** 0.5)

    def _expire_vehicle_tracks(self, frame_index: int, fps: float) -> None:
        """Remove tracks that have not been observed for the configured timeout."""
        max_missing_frames = max(1, int(self.vehicle_track_timeout_seconds * fps))
        stale_ids = [
            track_id for track_id, track in self._vehicle_tracks.items()
            if frame_index - track["last_seen_frame"] > max_missing_frames
        ]
        for track_id in stale_ids:
            self._vehicle_tracks.pop(track_id, None)

    def _get_or_create_vehicle_track(self, bbox, frame_index: int, fps: float) -> Dict:
        """Associate this vehicle observation with the nearest recent track."""
        best_track = None
        best_score = -1.0
        _, _, new_diag = self._bbox_center_and_diagonal(bbox)

        for track_id, track in self._vehicle_tracks.items():
            if track_id in self._matched_vehicle_track_ids:
                continue
            if frame_index - track["last_seen_frame"] > max(1, int(self.vehicle_track_timeout_seconds * fps)):
                continue

            iou = self._bbox_iou(bbox, track["bbox"])
            cx1, cy1, old_diag = self._bbox_center_and_diagonal(track["bbox"])
            cx2, cy2, _ = self._bbox_center_and_diagonal(bbox)
            distance = ((cx2 - cx1) ** 2 + (cy2 - cy1) ** 2) ** 0.5
            distance_limit = max(28.0, 0.45 * max(old_diag, new_diag))
            near_enough = distance <= distance_limit
            if iou < self.vehicle_track_iou_threshold and not near_enough:
                continue

            proximity_score = max(0.0, 1.0 - distance / distance_limit)
            score = iou + 0.15 * proximity_score
            if score > best_score:
                best_score = score
                best_track = track

        if best_track is None:
            track_id = self._next_vehicle_track_id
            self._next_vehicle_track_id += 1
            best_track = {
                "track_id": track_id,
            "bbox": tuple(bbox),
            "last_seen_frame": frame_index,
            "inside_streak": 0,
            "outside_streak": 0,
            "confirmed_inside": False,
            "alerted_for_entry": False,
            "seen_outside_before": False,
            "is_authorized": False,
            "plate_readings": [],
            "verified_plate": None,
            }
            self._vehicle_tracks[track_id] = best_track

        best_track["bbox"] = tuple(bbox)
        best_track["last_seen_frame"] = frame_index
        self._matched_vehicle_track_ids.add(best_track["track_id"])
        return best_track

    def _update_vehicle_zone_state(self, track: Dict, in_zone: bool) -> bool:
        """Return True once when the track has a confirmed transition into the zone."""
        if in_zone:
            track["inside_streak"] += 1
            track["outside_streak"] = 0
            if (not track["confirmed_inside"] and
                    track["inside_streak"] >= self.vehicle_entry_confirm_frames):
                track["confirmed_inside"] = True
                track["alerted_for_entry"] = False
                return True
            return False

        track["outside_streak"] += 1
        track["inside_streak"] = 0
        track["seen_outside_before"] = True
        if (track["confirmed_inside"] and
                track["outside_streak"] >= self.vehicle_exit_confirm_frames):
            track["confirmed_inside"] = False
            track["alerted_for_entry"] = False
        return False

    # --------------------------------------------------------
    # Person Evaluation
    # --------------------------------------------------------
    
    def _evaluate_person(self, person: PersonResult,
                          frame_index: int, fps: float) -> Optional[Alert]:
        """
        Evaluate a person detection and generate appropriate alert.
        
        Args:
            person: PersonResult from the face detector
            frame_index: Current frame index
            fps: Video FPS for cooldown
        
        Returns:
            Alert object or None if cooldown is active
        """
        # Suppress alerts for authorized individuals
        if person.is_authorized:
            print(f"[DecisionEngine] Authorized person detected ({person.identity}). Suppressing alert.")
            return None

        # Check cooldown to prevent duplicate alerts
        if self._is_in_cooldown("person", frame_index, fps):
            return None
        
        # Determine alert based on face detection status
        if person.face_detected:
            alert = Alert(
                timestamp=self._get_timestamp(frame_index, fps),
                frame_index=frame_index,
                alert_type="person",
                severity="HIGH",
                message="⚠️ UNAUTHORIZED PERSON detected in restricted area - Face identified",
                details={
                    "confidence": round(person.detection.confidence, 2),
                    "bbox": person.detection.bbox,
                    "face_detected": True,
                    "face_bbox": person.face_bbox
                }
            )
        else:
            alert = Alert(
                timestamp=self._get_timestamp(frame_index, fps),
                frame_index=frame_index,
                alert_type="person",
                severity="MEDIUM",
                message="⚠️ Person detected in restricted area - Face not clearly visible",
                details={
                    "confidence": round(person.detection.confidence, 2),
                    "bbox": person.detection.bbox,
                    "face_detected": False
                }
            )
        
        self._last_alert_frame["person"] = frame_index
        return alert
    
    # --------------------------------------------------------
    # Vehicle Evaluation
    # --------------------------------------------------------
    
    
    def _verify_vehicle_plate(self, track: Dict, plate_text: str) -> Optional[str]:
        """Return a normalized plate only after enough matching OCR readings."""
        clean_plate = re.sub(r"[^A-Z0-9]", "", plate_text.upper())

        if not clean_plate:
            return track.get("verified_plate")

        readings = track.setdefault("plate_readings", [])
        readings.append(clean_plate)

        # Keep only the most recent readings.
        del readings[:-self.plate_verification_window]

        
        counts = Counter(readings)
        candidate, count = counts.most_common(1)[0]

        print(
            f"[PlateVerification] Track {track.get('track_id')}: "
            f"readings={readings}, candidate={candidate}, "
            f"count={count}/{self.plate_verification_min_readings}"
        )

        if count >= self.plate_verification_min_readings:
            track["verified_plate"] = candidate
            print(
                f"[PlateVerification] Track {track.get('track_id')}: "
                f"verified plate {candidate}"
            )

        return track.get("verified_plate")


    
    def _evaluate_vehicle(self, vehicle: VehicleResult,
                        frame_index: int, fps: float) -> Optional[Alert]:
        """Track vehicles and update an existing alert when a plate becomes readable."""

        track = self._get_or_create_vehicle_track(
            vehicle.detection.bbox, frame_index, fps
        )

        # Check whether the detected plate belongs to an authorized vehicle.
        # Verify repeated OCR readings before authorizing by plate.
        verified_plate = track.get("verified_plate")

        if vehicle.plate_detected and vehicle.plate_text:
            verified_plate = self._verify_vehicle_plate(
                track, vehicle.plate_text
            )

        if verified_plate:
            for auth_plate in self._load_authorized_plates():
                clean_auth = re.sub(
                    r"[^A-Z0-9]", "", auth_plate.upper()
                )

                if verified_plate == clean_auth:
                    vehicle.is_authorized = True
                    vehicle.identity = auth_plate
                    break


        if vehicle.is_authorized:
            track["is_authorized"] = True

        if track["is_authorized"]:
            vehicle.is_authorized = True

        # Update entry/exit tracking for every vehicle observation.
        entry_confirmed = self._update_vehicle_zone_state(
            track,
            bool(getattr(vehicle, "in_restricted_zone", True))
        )

        # Ignore vehicles outside the restricted area.
        if not getattr(vehicle, "in_restricted_zone", True):
            return None

        # Authorized vehicles should not generate entry alerts.
        if track["is_authorized"]:
            # Remove a previous unidentified alert if this vehicle is
            # subsequently recognized as authorized.
            self.alerts[:] = [
                alert for alert in self.alerts
                if not (
                    alert.alert_type == "vehicle"
                    and (alert.details or {}).get("vehicle_track_id")
                        == track["track_id"]
                    and (alert.details or {}).get("event")
                        == "restricted_zone_entry"
                )
            ]

            track["alerted_for_entry"] = True
            return None

        # If an alert already exists, update it when the plate becomes readable.
        if track["alerted_for_entry"]:
            if vehicle.plate_detected and vehicle.plate_text:
                for existing_alert in reversed(self.alerts):
                    details = existing_alert.details or {}

                    if (
                        existing_alert.alert_type == "vehicle"
                        and details.get("vehicle_track_id") == track["track_id"]
                        and details.get("event") == "restricted_zone_entry"
                        and not details.get("plate_detected", False)
                    ):
                        existing_alert.message = (
                            f"Vehicle entered restricted area - "
                            f"Plate: {vehicle.plate_text}"
                        )
                        existing_alert.severity = "MEDIUM"

                        details["plate_detected"] = True
                        details["plate_text"] = vehicle.plate_text
                        details["confidence"] = round(
                            vehicle.detection.confidence, 2
                        )
                        details["bbox"] = vehicle.detection.bbox
                        existing_alert.details = details

                        print(
                            f"[DecisionEngine] Updated vehicle track "
                            f"{track['track_id']} with plate "
                            f"{vehicle.plate_text}"
                        )
                        break

            return None

        # Do not create an alert until entry is confirmed.
        if not entry_confirmed:
            return None

        crossed_from_outside = bool(track["seen_outside_before"])

        if vehicle.plate_detected and vehicle.plate_text:
            severity = "MEDIUM"

            if crossed_from_outside:
                message = (
                    f"Vehicle entered restricted area - "
                    f"Plate: {vehicle.plate_text}"
                )
            else:
                message = (
                    f"Vehicle observed inside restricted area - "
                    f"Plate: {vehicle.plate_text} "
                    f"(entry not visible in this clip)"
                )

            details = {
                "confidence": round(vehicle.detection.confidence, 2),
                "bbox": vehicle.detection.bbox,
                "plate_detected": True,
                "plate_text": vehicle.plate_text,
                "vehicle_type": vehicle.detection.class_label,
                "vehicle_track_id": track["track_id"],
                "event": "restricted_zone_entry",
                "entry_observed_from_outside": crossed_from_outside,
            }

        else:
            severity = "HIGH"

            if crossed_from_outside:
                message = (
                    "UNIDENTIFIED vehicle entered restricted area - "
                    "Plate not readable"
                )
            else:
                message = (
                    "UNIDENTIFIED vehicle observed inside restricted area - "
                    "Plate not readable (entry not visible in this clip)"
                )

            details = {
                "confidence": round(vehicle.detection.confidence, 2),
                "bbox": vehicle.detection.bbox,
                "plate_detected": False,
                "vehicle_type": vehicle.detection.class_label,
                "vehicle_track_id": track["track_id"],
                "event": "restricted_zone_entry",
                "entry_observed_from_outside": crossed_from_outside,
            }

        track["alerted_for_entry"] = True

        return Alert(
            timestamp=self._get_timestamp(frame_index, fps),
            frame_index=frame_index,
            alert_type="vehicle",
            severity=severity,
            message=message,
            details=details,
        )


    # --------------------------------------------------------
    # Animal Evaluation
    # --------------------------------------------------------
    
    def _evaluate_animal(self, animal: AnimalResult,
                          frame_index: int, fps: float) -> Optional[Alert]:
        """
        Evaluate an animal detection and generate appropriate alert.
        
        Args:
            animal: AnimalResult from the animal classifier
            frame_index: Current frame index
            fps: Video FPS for cooldown
        
        Returns:
            Alert object or None if cooldown is active
        """
        # Check cooldown
        if self._is_in_cooldown("animal", frame_index, fps):
            return None
        
        # Determine severity based on animal category
        if animal.risk_level == "high":
            severity = "CRITICAL"
            message = f"🐾 DANGEROUS ANIMAL ({animal.animal_type}) in restricted area!"
        elif animal.category == "wild":
            severity = "HIGH"
            message = f"🐾 Wild animal ({animal.animal_type}) detected in restricted area"
        else:
            severity = "LOW"
            message = f"🐾 Domestic animal ({animal.animal_type}) detected in restricted area"
        
        alert = Alert(
            timestamp=self._get_timestamp(frame_index, fps),
            frame_index=frame_index,
            alert_type="animal",
            severity=severity,
            message=message,
            details={
                "confidence": round(animal.detection.confidence, 2),
                "bbox": animal.detection.bbox,
                "animal_type": animal.animal_type,
                "category": animal.category,
                "risk_level": animal.risk_level
            }
        )
        
        self._last_alert_frame["animal"] = frame_index
        return alert
    
    # --------------------------------------------------------
    # Utility Methods
    # --------------------------------------------------------
    
    def _is_in_cooldown(self, alert_type: str,
                         current_frame: int, fps: float) -> bool:
        """
        Check if an alert type is still in cooldown period.
        Prevents generating duplicate alerts for the same object.
        
        Args:
            alert_type: Type of alert to check
            current_frame: Current frame index
            fps: Video frames per second
        
        Returns:
            True if still in cooldown, False if ready for new alert
        """
        if alert_type not in self._last_alert_frame:
            return False
        
        last_frame = self._last_alert_frame[alert_type]
        cooldown_frames = int(self.cooldown_seconds * fps)
        
        return (current_frame - last_frame) < cooldown_frames
    
    def _get_timestamp(self, frame_index: int, fps: float) -> str:
        """
        Convert frame index to a timestamp string (HH:MM:SS).
        
        Args:
            frame_index: Frame number
            fps: Video frames per second
        
        Returns:
            Formatted timestamp string
        """
        total_seconds = frame_index / fps if fps > 0 else 0
        hours = int(total_seconds // 3600)
        minutes = int((total_seconds % 3600) // 60)
        seconds = int(total_seconds % 60)
        return f"{hours:02d}:{minutes:02d}:{seconds:02d}"
    
    # --------------------------------------------------------
    # Summary & Export Methods
    # --------------------------------------------------------
    
    def get_summary(self) -> Dict:
        """
        Generate a summary of all detections and alerts.
        
        Returns:
            Dictionary containing detection counts, alert counts,
            and breakdown by type and severity
        """
        # Count total detections across all frames
        total_persons = sum(len(fr.persons) for fr in self.all_frame_results)
        total_vehicles = sum(len(fr.vehicles) for fr in self.all_frame_results)
        total_animals = sum(len(fr.animals) for fr in self.all_frame_results)
        motion_frames = sum(1 for fr in self.all_frame_results if fr.motion_detected)
        
        # Count alerts by severity
        severity_counts = {"LOW": 0, "MEDIUM": 0, "HIGH": 0, "CRITICAL": 0}
        for alert in self.alerts:
            severity_counts[alert.severity] = severity_counts.get(alert.severity, 0) + 1
        
        # Count alerts by type
        type_counts = {"person": 0, "vehicle": 0, "animal": 0}
        for alert in self.alerts:
            type_counts[alert.alert_type] = type_counts.get(alert.alert_type, 0) + 1
        
        return {
            "total_frames_processed": len(self.all_frame_results),
            "frames_with_motion": motion_frames,
            "total_detections": {
                "persons": total_persons,
                "vehicles": total_vehicles,
                "animals": total_animals,
                "total": total_persons + total_vehicles + total_animals
            },
            "total_alerts": len(self.alerts),
            "alerts_by_severity": severity_counts,
            "alerts_by_type": type_counts
        }
    
    def export_alerts_csv(self, filepath: str) -> None:
        """
        Export all alerts to a CSV file for record keeping.
        
        Args:
            filepath: Path to save the CSV file
        """
        # Ensure output directory exists
        os.makedirs(os.path.dirname(filepath) if os.path.dirname(filepath) else ".", exist_ok=True)
        
        with open(filepath, "w", newline="", encoding="utf-8") as f:
            writer = csv.writer(f)
            
            # Write header
            writer.writerow([
                "Timestamp", "Frame", "Type", "Severity",
                "Message", "Confidence", "Details"
            ])
            
            # Write each alert
            for alert in self.alerts:
                writer.writerow([
                    alert.timestamp,
                    alert.frame_index,
                    alert.alert_type,
                    alert.severity,
                    alert.message,
                    alert.details.get("confidence", "N/A"),
                    str(alert.details)
                ])
        
        print(f"[DecisionEngine] Alerts exported to: {filepath}")
    
    def reset(self) -> None:
        """
        Reset the decision engine state for processing a new video.
        Clears all stored alerts and frame results.
        """
        self.alerts.clear()
        self.all_frame_results.clear()
        self._last_alert_frame.clear()
        self._vehicle_tracks.clear()
        self._next_vehicle_track_id = 1
        self._matched_vehicle_track_ids.clear()
